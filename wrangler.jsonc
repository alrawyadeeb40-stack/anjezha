{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "anjezha",
  "main": "./worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}